#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // Windows用入力切り替え：Alt + Grave (~)

        ime_tog: ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LALT>;
        };

        // macOS用入力切り替え：Ctrl + Space

        mac_ime: mac_ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Win-Base {
            display-name = "Win-Base";
            bindings = <
&kp Q                                 &kp W       &kp E         &kp R                             &kp T                        &kp Y        &kp U         &kp I                                  &kp O          &kp P
&mt_exit_AML_on_tap_hwu LCTRL A       &kp S       &kp D         &kp F                             &kp G                        &kp H        &kp J         &kp K                                  &kp L          &mt_exit_AML_on_tap RCTRL MINUS
&mt_exit_AML_on_tap_hwu LEFT_SHIFT Z  &kp X       &kp C         &kp V                             &kp B      &lt 5 COMMA       &kp N        &kp M         &mkp MB1                               &mkp MB2       &mt_exit_AML_on_tap RIGHT_SHIFT SLASH
&kp TAB                               &kp ESCAPE  &kp LEFT_GUI  &hold_or_tap LEFT_ALT LANGUAGE_2  &kp SPACE  &lt 3 LANGUAGE_1  &lt 2 ENTER  &lt 6 PERIOD  &hold_or_tap_quick_tap_ms 1 BACKSPACE  &kp RIGHT_ALT  &hold_or_tap_quicktapms_kp RIGHT_WIN DEL
            >;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN        &kp HASH   &kp DOLLAR      &kp PERCENT                   &kp CARET              &kp AMPERSAND    &kp ASTERISK   &kp EQUAL         &kp PLUS
&kp SQT          &kp DOUBLE_QUOTES  &kp GRAVE  &kp TILDE       &kp LEFT_PARENTHESIS          &kp RIGHT_PARENTHESIS  &kp SEMICOLON    &kp COMMA      &kp PERIOD        &kp COLON
&trans           &kp BACKSLASH      &kp PIPE   &kp LEFT_BRACE  &kp LEFT_BRACKET      &trans  &kp RIGHT_BRACKET      &kp RIGHT_BRACE  &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION
&trans           &trans             &trans     &trans          &trans                &trans  &kp ENTER              &trans           &kp BACKSPACE  &trans            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Common_Layer {
            bindings = <
&kp ESCAPE      &kp LG(LS(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LG(LS(RIGHT_ARROW))  &trans          &kp LC(T)          &mkp MB4                &kp UP_ARROW    &mkp MB5                 &kp HOME
&kp TAB         &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans          &kp LC(PAGE_UP)    &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp PAGE_UP
&kp LEFT_SHIFT  &trans                  &trans              &trans                   &trans  &trans  &kp LC(PAGE_DOWN)  &kp LG(LC(LEFT_ARROW))  &kp LG(TAB)     &kp LG(LC(RIGHT_ARROW))  &kp PAGE_DOWN
&kp LCTRL       &trans                  &trans              &trans                   &trans  &trans  &trans             &kp LC(W)               &trans          &kp LA(TAB)              &kp END
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Scroll_Layer {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5           &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9   &kp PERCENT  &kp ASTERISK
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6   &kp PLUS     &kp MINUS
&kp F11  &kp F12  &trans  &trans  &trans   &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp PERIOD   &kp SLASH
&trans   &trans   &trans  &trans  &trans   &trans  &kp ENTER     &kp NUMBER_0  &kp BACKSPACE  &kp EQUAL    &trans
            >;
        };

        Setting_Layer {
            bindings = <
&studio_unlock  &trans  &trans  &trans  &trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans          &trans  &trans  &trans  &trans          &trans        &trans        &trans        &trans        &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans        &trans        &bootloader   &trans        &bt BT_CLR
&trans          &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &mkp MB4  &trans  &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        LAYER_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        automouse-layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
